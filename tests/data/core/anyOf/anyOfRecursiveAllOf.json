{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Each definition refers to itself through an allOf in its items or in a property, and the merge of that allOf leaves a schema that holds itself: the items of list's items, for one, are their own items. Each anyOf merges two such definitions, which reach those schemas at the same place, and must not follow them without end.",
  "type": "object",
  "properties": {
    "lists": {
      "anyOf": [{ "$ref": "#/definitions/list" }, { "$ref": "#/definitions/otherList" }]
    },
    "nodes": {
      "anyOf": [{ "$ref": "#/definitions/node" }, { "$ref": "#/definitions/otherNode" }]
    }
  },
  "definitions": {
    "list": {
      "type": "array",
      "items": { "allOf": [{ "$ref": "#/definitions/list" }], "items": { "type": "array" } }
    },
    "otherList": {
      "type": "array",
      "items": { "allOf": [{ "$ref": "#/definitions/otherList" }], "items": { "type": "array" } }
    },
    "node": {
      "type": "object",
      "properties": {
        "next": { "allOf": [{ "$ref": "#/definitions/node" }], "properties": { "next": { "type": "object" } } }
      }
    },
    "otherNode": {
      "type": "object",
      "properties": {
        "next": { "allOf": [{ "$ref": "#/definitions/otherNode" }], "properties": { "next": { "type": "object" } } }
      }
    }
  }
}
