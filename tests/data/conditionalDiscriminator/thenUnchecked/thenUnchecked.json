{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/thenUnchecked",
  "description": "The then branch only bounds x, which the validator does not check, so no branch compiles and detection declines with a warning.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "a",
        "b"
      ]
    },
    "x": {
      "type": "integer"
    }
  },
  "required": [
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "a"
          }
        }
      },
      "then": {
        "properties": {
          "x": {
            "minimum": 5
          }
        }
      }
    }
  ]
}
