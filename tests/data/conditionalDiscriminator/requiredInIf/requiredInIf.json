{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A conditional whose if lists the optional discriminator in required: the if is false when kind is absent, so values are required only for kind enum.",
  "properties": {
    "kind": { "type": "string", "enum": ["float", "enum", "boolean"] },
    "values": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "enum" } }, "required": ["kind"] },
      "then": { "required": ["values"] }
    }
  ]
}
