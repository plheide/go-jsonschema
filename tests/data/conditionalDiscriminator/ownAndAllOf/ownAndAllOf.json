{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/ownAndAllOf",
  "description": "An allOf of conditionals and an if/then of the object's own, on the same discriminator: they compile together.",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": { "type": "string", "enum": ["a", "b", "c"] },
    "x": { "type": "string" },
    "y": { "type": "string" },
    "z": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "a" } } }, "then": { "required": ["x"] } },
    { "if": { "properties": { "kind": { "const": "b" } } }, "then": { "required": ["y"] } }
  ],
  "if": { "properties": { "kind": { "const": "c" } } },
  "then": { "required": ["z"] }
}
