{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/ownWithNot",
  "description": "An if/then of the object's own compiles, while a not beside it is reported.",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": { "type": "string", "enum": ["a", "b"] },
    "x": { "type": "string" },
    "legacy": { "type": "string" }
  },
  "if": { "properties": { "kind": { "const": "a" } } },
  "then": { "required": ["x"] },
  "not": { "required": ["legacy"] }
}
