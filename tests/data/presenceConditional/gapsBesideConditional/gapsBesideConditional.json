{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/presenceConditional/gapsBesideConditional",
  "description": "An own conditional keyed on a value and a dependentSchemas entry, each checked in part: both report what they leave unchecked.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "a",
        "b"
      ]
    },
    "x": {
      "type": "string"
    },
    "y": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "a"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "required": [
      "x"
    ],
    "minProperties": 2
  },
  "dependentSchemas": {
    "y": {
      "required": [
        "x"
      ],
      "maxProperties": 3
    }
  }
}
