{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/dependentRequired/draft07",
  "description": "Draft-07's dependencies: a list of properties is checked, a schema is not.",
  "type": "object",
  "properties": {
    "shell": {
      "type": "string"
    },
    "run": {
      "type": "string"
    },
    "creditCard": {
      "type": "string"
    },
    "billingAddress": {
      "type": "string"
    }
  },
  "dependencies": {
    "shell": [
      "run"
    ],
    "creditCard": {
      "required": [
        "billingAddress"
      ]
    }
  }
}
