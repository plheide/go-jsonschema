{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/withPresence",
  "description": "Exactly one of id and name, and a not that forbids tag beside alias.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "alias": {
      "type": "string"
    }
  },
  "oneOf": [
    {
      "required": [
        "id"
      ]
    },
    {
      "required": [
        "name"
      ]
    }
  ],
  "not": {
    "required": [
      "tag",
      "alias"
    ]
  }
}
