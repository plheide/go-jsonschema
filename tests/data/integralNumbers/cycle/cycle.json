{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/action",
  "description": "A type whose decoder is made while the type is generated, as an anyOf of its own $ref inside it makes it, is decoded as its finished type is.",
  "definitions": {
    "action": {
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "emit": { "$ref": "#/definitions/emit" },
        "limit": { "type": "integer" }
      },
      "additionalProperties": { "type": "integer" }
    },
    "other": {
      "type": "object",
      "properties": { "name": { "type": "string" } }
    },
    "emit": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": { "anyOf": [{ "$ref": "#/definitions/action" }, { "$ref": "#/definitions/other" }] }
        }
      }
    }
  }
}
