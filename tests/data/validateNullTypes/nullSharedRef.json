{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Definitions that an anyOf and other properties both use. The anyOf reads foo and bar with null, which it allows, and upToThree, which has no type, with its parent's type, string. Neither may change the definitions: foo still rejects null, and word, a upToThree with no type, accepts it.",
  "type": "object",
  "properties": {
    "either": {
      "anyOf": [
        { "$ref": "#/definitions/foo" },
        { "$ref": "#/definitions/bar" },
        { "type": "null" }
      ]
    },
    "foo": { "$ref": "#/definitions/foo" },
    "short": {
      "type": "string",
      "anyOf": [{ "$ref": "#/definitions/upToThree" }]
    },
    "word": { "$ref": "#/definitions/upToThree" }
  },
  "definitions": {
    "foo": {
      "type": "object",
      "properties": { "x": { "type": "string" } },
      "required": ["x"]
    },
    "bar": {
      "type": "object",
      "properties": { "y": { "type": "string" } },
      "required": ["y"]
    },
    "upToThree": { "maxLength": 3 }
  }
}
