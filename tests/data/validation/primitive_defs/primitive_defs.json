{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://example.com/array",
  "type": "object",
  "$defs": {
    "minStr": {
      "type": "string",
      "minLength": 5
    },
    "upperCode": {
      "type": "string",
      "pattern": "^[A-Z]+$"
    }
  },
  "properties": {
    "myString": {
      "$ref": "#/$defs/minStr"
    },
    "myNullableString": {
      "$ref": "#/$defs/minStr"
    },
    "myCode": {
      "$ref": "#/$defs/upperCode"
    }
  },
  "required": [
    "myString"
  ]
}
