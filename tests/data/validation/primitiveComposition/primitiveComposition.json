{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "level": {
      "type": "string",
      "oneOf": [
        {"const": "low", "description": "Low."},
        {"const": "high", "description": "High."}
      ]
    }
  },
  "properties": {
    "level": {"$ref": "#/definitions/level"},
    "mode": {
      "type": "string",
      "anyOf": [{"const": "fast"}, {"enum": ["slow", "off"]}, {"const": "say \"hi\"\\"}]
    },
    "code": {
      "type": "string",
      "anyOf": [{"pattern": "^[a-z]+$"}, {"type": "string", "maxLength": 2}, {"type": "integer"}]
    },
    "id": {
      "type": "string",
      "oneOf": [{"pattern": "^a"}, {"maxLength": 3}]
    },
    "port": {
      "type": "integer",
      "anyOf": [{"maximum": 1023}, {"minimum": 8000, "maximum": 8999}]
    },
    "step": {
      "type": "number",
      "oneOf": [{"multipleOf": 2}, {"multipleOf": 3}]
    },
    "count": {
      "type": "integer",
      "oneOf": [{"const": 1}, {"const": 2.5}, {"enum": [3, 4]}]
    },
    "big": {
      "type": "integer",
      "oneOf": [{"const": 5000000000}, {"const": 1}]
    },
    "ratio": {
      "type": "number",
      "anyOf": [{"const": 0}, {"const": -0}, {"enum": [0.5, 1]}]
    },
    "sign": {
      "type": "number",
      "oneOf": [{"const": 0}, {"const": -0}, {"const": 2}]
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "anyOf": [{"pattern": "^x"}, {"const": "y"}]}
    }
  }
}
